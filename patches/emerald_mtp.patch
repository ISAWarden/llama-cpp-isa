diff --git a/tests/test-emerald-mtp-bench.cpp b/tests/test-emerald-mtp-bench.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3bbeb40614c155cb46ca392e4ec31917d25b57ae
--- /dev/null
+++ b/tests/test-emerald-mtp-bench.cpp
@@ -0,0 +1,61 @@
+#include "emerald-mtp.h"
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+#include <random>
+#include <stdexcept>
+
+// Opt-in lookup microbenchmark: test-emerald-mtp-bench [corpus_tokens] [queries].
+// Run independently of builds/inference. Synthetic results do not predict acceptance.
+int main(int argc, char ** argv) {
+    using clock = std::chrono::steady_clock;
+    const size_t count = argc > 1 ? std::stoull(argv[1]) : 200000;
+    const size_t queries = argc > 2 ? std::stoull(argv[2]) : 20000;
+    if (count < 64 || !queries) { return 1; }
+    const auto dir = std::filesystem::temp_directory_path() / ("emerald-bench-" + std::to_string(clock::now().time_since_epoch().count()));
+    std::filesystem::create_directory(dir); const auto path = (dir / "graph").string();
+    try {
+        std::mt19937 rng(42); std::vector<llama_token> corpus(count);
+        for (auto & t : corpus) { t = rng()%1000000; }
+        std::vector<llama_token> branch(25, 1000001);
+        auto start = clock::now();
+        {
+            emerald_database db(path, "benchmark-vocabulary", 24, 0, true);
+            db.observe(corpus, true);
+            for (int i = 0; i < 1024; ++i) { branch.back() = 1000002+i; db.observe(branch, true); }
+            auto indexed = clock::now(); db.flush();
+            std::cout << "index_ms=" << std::chrono::duration<double,std::milli>(indexed-start).count()
+                      << " save_ms=" << std::chrono::duration<double,std::milli>(clock::now()-indexed).count()
+                      << " file_bytes=" << std::filesystem::file_size(path) << '\n';
+        }
+        start = clock::now();
+        {
+            emerald_database db(path, "benchmark-vocabulary", 24, 0, false);
+            std::cout << "load_ms=" << std::chrono::duration<double,std::milli>(clock::now()-start).count() << '\n';
+            uint64_t checksum = 0;
+            for (int mode = 0; mode < 3; ++mode) {
+                std::vector<double> ns; ns.reserve(queries);
+                for (size_t i = 0; i < queries+1000; ++i) {
+                    size_t pos = rng()%(count-40);
+                    std::vector<llama_token> key(corpus.begin()+pos, corpus.begin()+pos+24);
+                    if (mode == 1) { key[0] = 2000000; }
+                    if (mode == 2) { key.assign(24, 1000001); }
+                    auto before = clock::now(); auto result = db.draft(key, 1, 16); auto after = clock::now();
+                    if ((mode == 0 && (result.size() != 16 || !std::equal(result.begin(), result.end(), corpus.begin()+pos+24))) ||
+                        (mode == 1 && !result.empty()) || (mode == 2 && result != std::vector<llama_token>{1000002})) {
+                        throw std::runtime_error("unexpected draft");
+                    }
+                    checksum += result.size();
+                    if (i >= 1000) { ns.push_back(std::chrono::duration<double,std::nano>(after-before).count()); }
+                }
+                std::sort(ns.begin(), ns.end());
+                std::cout << (mode == 0 ? "hit16" : mode == 1 ? "miss" : "fanout1024")
+                          << " p50_ns=" << ns[ns.size()/2] << " p95_ns=" << ns[ns.size()*95/100]
+                          << " p99_ns=" << ns[ns.size()*99/100] << '\n';
+            }
+            std::cout << "checked_tokens=" << checksum << '\n';
+        }
+        std::filesystem::remove_all(dir); return 0;
+    } catch (const std::exception & e) { std::cerr << e.what() << " (fixtures: " << dir << ")\n"; return 1; }
+}
