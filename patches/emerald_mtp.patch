+        auto shrink = (dir / "shrink-journal").string(); uint64_t retained_count;
+        {
+            emerald_database db(shrink, "v", 2, 0, true); db.observe({1,2,3}, true); db.flush();
+            for (int i = 100; i < 400; i += 3) { db.observe({i,i+1,i+2}, false); }
+            db.flush(); CHECK(db.size_bytes() > std::filesystem::file_size(shrink));
+        }
+        {
+            auto limit = std::filesystem::file_size(shrink); emerald_database db(shrink, "v", 2, limit, false);
+            retained_count = db.statistics().learned; CHECK(retained_count < 100); CHECK(db.size_bytes() <= limit); db.flush();
+        }
+        { emerald_database db(shrink, "v", 2, 0, false); CHECK(db.statistics().learned == retained_count); }
+        // A configured limit does not turn each small journal flush into a snapshot.
+        auto limited_journal = (dir / "limited-journal").string();
+        {
+            emerald_database db(limited_journal, "v", 2, 1000000, true);
+            db.observe({1,2,3}, true); db.flush(); auto initial = std::filesystem::file_size(limited_journal);
+            db.observe({1,2,3}, false); db.flush();
+            std::ifstream in(limited_journal, std::ios::binary); in.seekg(initial+8);
+            CHECK(in.get() == 2); CHECK(std::filesystem::file_size(limited_journal) == initial+64+8+12);
+        }
+        // A mostly repeated long observation stores only its novel fragment, even
+        // when persistence compacts a copy and the live graph remains in service.
+        auto overlap = (dir / "overlap").string();
+        {
+            emerald_database db(overlap, "v", 2, 0, true); key seq(5000);
+            for (size_t i = 0; i < seq.size(); ++i) { seq[i] = i; }
+            db.observe(seq, true); db.flush(); auto initial = db.size_bytes();
+            seq.back() = 9000; db.observe(seq, true);
+            CHECK(db.size_bytes() <= initial+256); db.flush();
+            CHECK(db.size_bytes() == std::filesystem::file_size(overlap));
+        }
+        // Snapshot capture and journal detachment race with observations and drafts.
+        auto concurrent = (dir / "concurrent").string();
+        {
+            emerald_database db(concurrent, "v", 2, 0, true, true);
+            db.observe({1,2,3,4,5}, true); db.flush();
+            std::atomic<bool> done{false}; std::exception_ptr writer_error, flush_error;
+            std::thread writer([&] { try {
+                for (int i = 0; i < 3000; ++i) { db.observe({1,2,3,4,5}, false); }
+            } catch (...) { writer_error = std::current_exception(); } done = true; });
+            std::thread saver([&] { try { while (!done) { db.flush(); } }
+                catch (...) { flush_error = std::current_exception(); } });
+            bool drafts_ok = true;
+            while (!done) { drafts_ok = drafts_ok && db.draft({1,2},1,8) == key({3,4,5}); }
+            writer.join(); saver.join();
+            if (writer_error) { std::rethrow_exception(writer_error); } if (flush_error) { std::rethrow_exception(flush_error); }
+            CHECK(drafts_ok); db.flush();
+        }
+        { emerald_database db(concurrent, "v", 2, 0, false);
+          CHECK(db.statistics().learned == 9000); CHECK(db.statistics().imported == 3);
+          CHECK(db.draft({1,2},1,8) == key({3,4,5})); }
+        std::filesystem::remove_all(dir); std::cout << "EmeraldMTP database tests passed\n"; return 0;
+    } catch (const std::exception & e) { std::cerr << e.what() << " (fixtures: " << dir << ")\n"; return 1; }
+}
