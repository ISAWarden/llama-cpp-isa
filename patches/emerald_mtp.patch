+++ b/tests/test-emerald-mtp-checkpoint.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Real-model checkpoint/replay test; pass a recurrent/hybrid GGUF such as Qwen3.5."""
+import argparse
+import collections
+import pathlib
+import runpy
+import subprocess
+
+helpers = runpy.run_path(str(pathlib.Path(__file__).with_name("test-emerald-mtp-server.py")))
+server, completion, post, learned_counts = (helpers[k] for k in ("server", "completion", "post", "learned_counts"))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    for name in ("server", "upstream", "importer", "model", "output-dir"):
+        parser.add_argument("--" + name, required=True)
+    args = parser.parse_args()
+    out = pathlib.Path(args.output_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    prompt = "Write a short Python function to compute the factorial of a non-negative integer.\n"
+    with server(args.upstream, args.model, out, "checkpoint-upstream") as port:
+        baseline = completion(port, prompt, n_predict=96)
+        ids = post(port, "tokenize", {"content": prompt, "add_special": True})["tokens"]
+        source = post(port, "detokenize", {"tokens": ids + baseline["tokens"][:20]})["content"]
+    corpus = out / "checkpoint.txt"
+    corpus.write_text(source + " incorrect imported text must be rejected by the target model " * 30)
+    db = out / "checkpoint.bin"
+    with open(out / "checkpoint-import.log", "w") as log:
+        subprocess.run([args.importer, "-m", args.model, "--input", str(corpus), "--output", str(db),
+                        "--n-match", "4"], check=True, stdout=log, stderr=log)
+    with server(args.server, args.model, out, "checkpoint-emerald",
+                ["--spec-type", "emerald-mtp", "--spec-emerald-mtp-file", str(db),
+                 "--spec-emerald-mtp-n-min", "2", "--spec-emerald-mtp-n-max", "8", "--verbosity", "5"]) as port:
+        actual = completion(port, prompt, n_predict=96)
+    assert actual["tokens"] == baseline["tokens"], "greedy output differs after checkpoint replay"
+    assert actual["timings"]["draft_n"] > actual["timings"]["draft_n_accepted"], "no rejected drafts"
+    seq = ids + actual["tokens"]
+    assert learned_counts(db)[1] == collections.Counter(tuple(seq[i:i+5]) for i in range(len(seq)-4))
+    log = (out / "checkpoint-emerald.log").read_text()
+    assert "restor" in log.lower() and "checkpoint" in log.lower(), "checkpoint path not exercised"
+    print("Hybrid/recurrent greedy parity and exact learning counts after rejected-draft checkpoint replay passed")
+    print(actual["timings"])
+
+
+if __name__ == "__main__":
+    main()
