index 0000000000000000000000000000000000000000..4ae7c2513f868149e2ca77af68c6e870da07ed1e
--- /dev/null
+++ b/common/emerald-mtp.cpp
@@ -0,0 +1,584 @@
+#include "emerald-mtp.h"
+#include "gguf.h"
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+#endif
+
+namespace {
+using bytes = std::vector<uint8_t>;
+constexpr uint64_t empty = UINT64_MAX;
+uint64_t hash(const uint8_t * p, size_t n) {
+    uint64_t h = 14695981039346656037ULL;
+    for (size_t i = 0; i < n; ++i) { h = (h ^ p[i]) * 1099511628211ULL; }
+    return h;
+}
+void put(bytes & b, uint64_t v, int n = 8) { for (int i = 0; i < n; ++i) { b.push_back(uint8_t(v >> (8*i))); } }
+struct reader {
+    const bytes & b; size_t pos = 0;
+    uint64_t get(int n = 8) {
+        if (size_t(n) > b.size() - pos) { throw std::runtime_error("truncated EmeraldMTP data"); }
+        uint64_t v = 0; for (int i = 0; i < n; ++i) { v |= uint64_t(b[pos++]) << (8*i); } return v;
+    }
+};
+struct writer_lock {
+#ifdef _WIN32
+    HANDLE fd = INVALID_HANDLE_VALUE;
+    explicit writer_lock(const std::string & path) {
+        fd = CreateFileW(std::filesystem::path(path + ".lock").c_str(), GENERIC_READ | GENERIC_WRITE, 0,
+                         nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (fd == INVALID_HANDLE_VALUE) { throw std::runtime_error("EmeraldMTP database writer is locked"); }
+    }
+    ~writer_lock() { CloseHandle(fd); }
+#else
+    int fd;
+    explicit writer_lock(const std::string & path) {
+        fd = open((path + ".lock").c_str(), O_CREAT | O_RDWR, 0600);
+        if (fd < 0) { throw std::runtime_error("cannot open EmeraldMTP writer lock"); }
+        if (flock(fd, LOCK_EX | LOCK_NB)) { close(fd); throw std::runtime_error("EmeraldMTP database writer is locked"); }
+    }
+    ~writer_lock() { close(fd); }
+#endif
+};
+void sync_file(const std::string & path) {
+#ifdef _WIN32
+    HANDLE f = CreateFileW(std::filesystem::path(path).c_str(), GENERIC_WRITE, FILE_SHARE_READ, nullptr, OPEN_EXISTING, 0, nullptr);
+    if (f == INVALID_HANDLE_VALUE) { throw std::runtime_error("EmeraldMTP sync open failed"); }
+    bool ok = FlushFileBuffers(f); CloseHandle(f);
+#else
+    int f = open(path.c_str(), O_RDONLY);
+    if (f < 0) { throw std::runtime_error("EmeraldMTP sync open failed"); }
+    bool ok = fsync(f) == 0; close(f);
+#endif
+    if (!ok) { throw std::runtime_error("EmeraldMTP sync failed"); }
+}
+constexpr uint64_t frame_magic = 0x3130485041524745ULL; // "EGRAPH01"
+constexpr uint64_t frame_header = 64;
+uint64_t aligned(uint64_t v) {
+    if (v > UINT64_MAX - 63) { throw std::runtime_error("EmeraldMTP size overflow"); }
+    return (v + 63) & ~uint64_t(63);
+}
+void write_frame(std::ostream & out, uint32_t kind, const bytes & b) {
+    bytes h; put(h, frame_magic); put(h, kind, 4); put(h, 0, 4);
+    put(h, b.size()); put(h, hash(b.data(), b.size())); h.resize(frame_header);
+    out.write((const char *) h.data(), h.size()); out.write((const char *) b.data(), b.size());
+    if (!out) { throw std::runtime_error("EmeraldMTP write failed"); }
+}
+}
+
+uint64_t emerald_size_limit(const std::string & gb) {
+    size_t end; double d = std::stod(gb, &end);
+    if (end != gb.size() || !std::isfinite(d) || d < 0 || d * 1e9 >= double(UINT64_MAX)) {
+        throw std::invalid_argument("invalid EmeraldMTP size in decimal GB");
+    }
+    if (d > 0 && d * 1e9 < 1) { throw std::invalid_argument("EmeraldMTP size limit is less than one byte"); }
+    return uint64_t(d * 1e9);
+}
+std::string emerald_tokenizer_fingerprint(const std::string & model) {
+    gguf_init_params params = {true, nullptr};
+    auto * src = gguf_init_from_file(model.c_str(), params);
+    if (!src) { throw std::runtime_error("cannot read tokenizer GGUF"); }
+    auto * dst = gguf_init_empty(); gguf_set_kv(dst, src); gguf_free(src);
+    for (int64_t i = gguf_get_n_kv(dst); i-- > 0;) {
+        std::string key = gguf_get_key(dst, i);
+        if (key.compare(0, 10, "tokenizer.") != 0) { gguf_remove_key(dst, key.c_str()); }
+    }
+    if (!gguf_get_n_kv(dst)) { gguf_free(dst); throw std::runtime_error("GGUF has no tokenizer"); }
+    bytes b(gguf_get_meta_size(dst)); gguf_get_meta_data(dst, b.data()); gguf_free(dst);
+    // Retain the full canonical tokenizer metadata: equality is collision-free.
+    return std::string((const char *) b.data(), b.size());
+}
+
+namespace {
+// Hot nodes contain only the key location and the next drafting step. Counts and
+// alternative continuations are accessed by writers, not successful graph walks.
+struct emerald_graph {
+    struct entry { uint64_t offset, imported, learned, seen, next; };
+    struct node { uint64_t offset, successor; llama_token token; };
+    struct metadata { uint64_t first, best, miss_generation; };
+    uint32_t n;
+    uint64_t clock = 0;
+    std::vector<llama_token> tokens;
+    std::vector<entry> entries;
+    std::vector<node> nodes;
+    std::vector<metadata> meta;
+    std::vector<uint64_t> table;
+    std::vector<uint8_t> tags;
+    explicit emerald_graph(uint32_t n = 24) : n(n), table(16, empty), tags(16) {}
+    uint64_t key_hash(const llama_token * t) const {
+        // Token-wise mixing; serialized indices use this exact unsigned arithmetic.
+        uint64_t h = 0x9e3779b97f4a7c15ULL;
+        for (uint32_t i = 0; i < n; ++i) {
+            h ^= uint32_t(t[i]) + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
+        }
+        h ^= h >> 30; h *= 0xbf58476d1ce4e5b9ULL;
+        h ^= h >> 27; h *= 0x94d049bb133111ebULL;
+        return h ^ (h >> 31);
+    }
+    uint64_t find(const llama_token * key) const {
+        auto h = key_hash(key); size_t b = h & (table.size()-1);
+        for (size_t probes = 0; probes < table.size(); ++probes, b = (b+1) & (table.size()-1)) {
+            auto id = table[b];
+            if (id == empty) { return empty; }
+            if (tags[b] == uint8_t(h >> 56) && std::equal(key, key+n, tokens.data()+nodes[id].offset)) { return id; }
+        }
+        throw std::runtime_error("invalid EmeraldMTP full index");
+    }
+    void index_node(uint64_t id) {
+        auto h = key_hash(tokens.data()+nodes[id].offset); size_t b = h & (table.size()-1);
+        while (table[b] != empty) { b = (b+1) & (table.size()-1); }
+        table[b] = id; tags[b] = uint8_t(h >> 56);
+    }
+    void grow() {
+        if (nodes.size()*2 <= table.size()) { return; }
+        table.assign(table.size()*2, empty); tags.assign(table.size(), 0);
+        for (size_t i = 0; i < nodes.size(); ++i) { index_node(i); }
+    }
+    static uint64_t score(const entry & e) {
+        return e.imported > UINT64_MAX-e.learned ? UINT64_MAX : e.imported+e.learned;
+    }
+    void consider(uint64_t id, uint64_t edge) {
+        auto & m = meta[id]; auto & v = nodes[id]; const auto & e = entries[edge];
+        auto token = tokens[e.offset+n];
+        if (m.best == empty || score(e) > score(entries[m.best]) ||
+                (score(e) == score(entries[m.best]) && token < v.token)) {
+            m.best = edge;
+            if (v.token != token) { v.token = token; v.successor = empty; m.miss_generation = empty; }
+        }
+    }
+    uint64_t successor(uint64_t id) {
+        auto & v = nodes[id]; auto & m = meta[id];
+        if (v.successor == empty && m.miss_generation != nodes.size()) {
+            // A cached miss is retried only after insertion of a new context.
+            v.successor = find(tokens.data()+entries[m.best].offset+1);
+            m.miss_generation = nodes.size();
+        }
+        return v.successor;
+    }
+    void reindex() {
+        nodes.clear(); meta.clear(); table.assign(16, empty); tags.assign(16, 0);
+        for (size_t i = 0; i < entries.size(); ++i) {
+            auto & e = entries[i]; auto id = find(tokens.data()+e.offset);
+            if (id == empty) {
+                id = nodes.size(); nodes.push_back({e.offset, empty, -1}); meta.push_back({empty, empty, empty});
+                if (nodes.size()*2 > table.size()) { grow(); } else { index_node(id); }
+            }
+            e.next = meta[id].first; meta[id].first = i; consider(id, i);
+        }
+        for (size_t i = 0; i < nodes.size(); ++i) { successor(i); }
+    }
+    uint64_t size(uint64_t fp) const {
+        uint64_t end = aligned(128+fp);
+        end = aligned(end+tokens.size()*4ULL);
+        end = aligned(end+nodes.size()*32ULL);
+        end = aligned(end+entries.size()*32ULL);
+        end = aligned(end+table.size()*8ULL);
+        return frame_header + aligned(end+tags.size());
+    }
+    void pack() {
+        // Reclaim unused token ranges while preserving shared windows in surviving sequences.
+        std::vector<std::pair<uint64_t, uint64_t>> ranges;
+        for (const auto & e : entries) { ranges.emplace_back(e.offset, e.offset+n+1); }
+        std::sort(ranges.begin(), ranges.end());
+        std::vector<std::pair<uint64_t, uint64_t>> merged;
+        for (auto r : ranges) {
+            if (!merged.empty() && r.first <= merged.back().second) { merged.back().second = std::max(merged.back().second, r.second); }
+            else { merged.push_back(r); }
+        }
+        std::vector<uint64_t> starts; std::vector<llama_token> compact;
+        for (auto r : merged) { starts.push_back(compact.size()); compact.insert(compact.end(), tokens.begin()+r.first, tokens.begin()+r.second); }
+        for (auto & e : entries) {
+            auto it = std::upper_bound(merged.begin(), merged.end(), std::make_pair(e.offset, UINT64_MAX)); --it;
+            e.offset = starts[it-merged.begin()] + e.offset-it->first;
+        }
+        tokens.swap(compact); reindex();
+    }
+    bool retain(bool imported, uint64_t limit, uint64_t fp, bool * changed = nullptr) {
+        if (!limit || size(fp) <= limit) { return true; }
+        pack();
+        if (size(fp) <= limit) { return true; }
+        while (size(fp) > limit) {
+            std::vector<size_t> order;
+            for (size_t i = 0; i < entries.size(); ++i) { if (entries[i].learned) { order.push_back(i); } }
+            if (order.empty()) {
+                if (imported) { throw std::runtime_error("protected imported data exceeds EmeraldMTP size limit"); }
+                return false;
+            }
+            std::stable_sort(order.begin(), order.end(), [this](size_t a, size_t b) { return entries[a].seen < entries[b].seen; });
+            // Delete a batch using an upper bound on reclaimed bytes, then measure packed size.
+            // This avoids deleting a newer entry when removing an older one already suffices.
+            const uint64_t row_max = 80 + 4ULL*(n+1) + 6*63 + table.size()*9ULL;
+            uint64_t remaining = (size(fp)-limit + row_max-1)/row_max;
+            for (auto i : order) {
+                if (!remaining) { break; }
+                entries[i].learned = 0;
+                if (changed) { *changed = true; }
+                if (!entries[i].imported) { --remaining; }
+            }
+            entries.erase(std::remove_if(entries.begin(), entries.end(), [](const entry & e) { return !e.imported && !e.learned; }), entries.end());
+            pack();
+        }
+        return true;
+    }
+    void add(const std::vector<llama_token> & seq, bool imported) {
+        if (seq.size() <= n) { return; }
+        size_t range_start = 0, range_end = 0; uint64_t range_base = 0; bool have_range = false;
+        for (size_t i = 0; i+n < seq.size(); ++i) {
+            auto id = find(seq.data()+i); uint64_t found = empty;
+            if (id != empty) {
+                for (auto j = meta[id].first; j != empty; j = entries[j].next) {
+                    if (tokens[entries[j].offset+n] == seq[i+n]) { found = j; break; }
+                }
+            }
+            if (found == empty) {
+                // Keep only new fragments, sharing overlapping windows. This also
+                // bounds live token storage while a captured snapshot is packed.
+                if (!have_range || i > range_end) {
+                    range_start = range_end = i; range_base = tokens.size(); have_range = true;
+                    if (tokens.size() >= n && std::equal(seq.begin()+i, seq.begin()+i+n, tokens.end()-n)) {
+                        range_base -= n; range_end += n;
+                    }
+                }
+                tokens.insert(tokens.end(), seq.begin()+range_end, seq.begin()+i+n+1); range_end = i+n+1;
+                const uint64_t offset = range_base+i-range_start;
+                if (id == empty) {
+                    id = nodes.size(); nodes.push_back({offset, empty, -1}); meta.push_back({empty, empty, empty});
+                    if (nodes.size()*2 > table.size()) { grow(); } else { index_node(id); }
+                }
+                found = entries.size(); entries.push_back({offset, 0, 0, 0, meta[id].first}); meta[id].first = found;
+            }
+            auto & e = entries[found]; auto & count = imported ? e.imported : e.learned;
+            if (count == UINT64_MAX || clock == UINT64_MAX) { throw std::runtime_error("EmeraldMTP counter overflow"); }
+            ++count; e.seen = ++clock; consider(id, found);
+        }
+    }
+    bytes snapshot(const std::string & fingerprint) {
+        pack();
+        // Group continuation IDs only; avoid another full copy of entry records.
+        std::vector<uint64_t> grouped; grouped.reserve(entries.size());
+        const uint64_t fp_at = 128, tok_at = aligned(fp_at+fingerprint.size());
+        const uint64_t node_at = aligned(tok_at+tokens.size()*4ULL), edge_at = aligned(node_at+nodes.size()*32ULL);
+        const uint64_t index_at = aligned(edge_at+entries.size()*32ULL), tag_at = aligned(index_at+table.size()*8ULL);
+        const uint64_t end = aligned(tag_at+tags.size());
+        bytes b; b.reserve(end);
+        put(b, n, 4); put(b, 0, 4); put(b, clock); put(b, fingerprint.size());
+        put(b, tokens.size()); put(b, nodes.size()); put(b, entries.size()); put(b, table.size());
+        for (auto v : {fp_at, tok_at, node_at, edge_at, index_at, tag_at, end}) { put(b, v); }
+        b.resize(fp_at); b.insert(b.end(), fingerprint.begin(), fingerprint.end()); b.resize(tok_at);
+        for (auto t : tokens) { put(b, uint32_t(t), 4); }
+        b.resize(node_at);
+        for (size_t i = 0; i < nodes.size(); ++i) {
+            std::vector<uint64_t> ids;
+            for (auto j = meta[i].first; j != empty; j = entries[j].next) { ids.push_back(j); }
+            std::sort(ids.begin(), ids.end());
+            put(b, nodes[i].offset); put(b, grouped.size()); put(b, nodes[i].successor);
+            put(b, ids.size(), 4); put(b, uint32_t(nodes[i].token), 4);
+            grouped.insert(grouped.end(), ids.begin(), ids.end());
+        }
+        b.resize(edge_at);
+        for (auto id : grouped) {
+            const auto & e = entries[id]; put(b, e.offset); put(b, e.imported); put(b, e.learned); put(b, e.seen);
+        }
+        b.resize(index_at); for (auto id : table) { put(b, id); }
+        b.resize(tag_at); b.insert(b.end(), tags.begin(), tags.end()); b.resize(end);
+        return b;
+    }
+    void load_snapshot(const bytes & b, const std::string & fingerprint, uint32_t requested, int32_t vocab_size) {
+        reader r{b}; n = r.get(4);
+        if (!n || n > 1024 || (requested && requested != n)) { throw std::runtime_error("EmeraldMTP lookup length mismatch"); }
+        if (r.get(4)) { throw std::runtime_error("invalid EmeraldMTP flags"); }
+        clock = r.get(); auto fp = r.get(), nt = r.get(), nn = r.get(), ne = r.get(), cap = r.get();
+        const uint64_t widths[] = {1, 4, 32, 32, 8, 1};
+        const uint64_t lengths[] = {fp, nt, nn, ne, cap, cap};
+        uint64_t offsets[6]; uint64_t end = 128;
+        for (size_t i = 0; i < 6; ++i) {
+            offsets[i] = r.get();
+            if (offsets[i] != end || end > b.size() || lengths[i] > (b.size()-end)/widths[i]) {
+                throw std::runtime_error("invalid EmeraldMTP sections");
+            }
+            end = aligned(end + lengths[i]*widths[i]);
+        }
+        if (r.get() != end || end != b.size() || r.get() || r.get() || cap < 16 || (cap & (cap-1)) || nn > cap/2 || nn > ne) {
+            throw std::runtime_error("invalid EmeraldMTP graph header");
+        }
+        if (fp != fingerprint.size() || std::memcmp(b.data()+offsets[0], fingerprint.data(), fp)) {
+            throw std::runtime_error("EmeraldMTP tokenizer mismatch");
+        }
+        for (size_t i = 0; i < 6; ++i) {
+            const auto from = offsets[i]+lengths[i]*widths[i];
+            const auto to = i == 5 ? end : offsets[i+1];
+            for (auto j = from; j < to; ++j) { if (b[j]) { throw std::runtime_error("invalid EmeraldMTP padding"); } }
+        }
+        r.pos = offsets[1]; tokens.reserve(nt);
+        for (uint64_t i = 0; i < nt; ++i) {
+            auto t = r.get(4); if (t >= uint64_t(vocab_size)) { throw std::runtime_error("invalid EmeraldMTP token"); }
+            tokens.push_back(t);
+        }
+        r.pos = offsets[2]; std::vector<uint64_t> counts; uint64_t consumed = 0;
+        for (uint64_t i = 0; i < nn; ++i) {
+            auto offset = r.get(), first = r.get(), next = r.get();
+            auto count = r.get(4), token = r.get(4);
+            if (nt < n || offset > nt-n || first != consumed || !count || count > ne-consumed ||
+                (next != empty && next >= nn) || token >= uint64_t(vocab_size)) {
+                throw std::runtime_error("invalid EmeraldMTP node");
+            }
+            nodes.push_back({offset, next, llama_token(token)}); meta.push_back({first, empty, nn}); counts.push_back(count);
+            consumed += count;
+        }
+        if (consumed != ne) { throw std::runtime_error("unowned EmeraldMTP continuations"); }
+        r.pos = offsets[3]; entries.reserve(ne);
+        for (uint64_t i = 0; i < ne; ++i) {
+            entry e{r.get(), r.get(), r.get(), r.get(), empty};
+            if (nt <= n || e.offset >= nt-n || (!e.imported && !e.learned) || !e.seen || e.seen > clock) {
+                throw std::runtime_error("invalid EmeraldMTP continuation");
+            }
+            entries.push_back(e);
+        }
+        r.pos = offsets[4]; table.clear(); tags.assign(b.begin()+offsets[5], b.begin()+offsets[5]+cap);
+        std::vector<bool> indexed(nn);
+        for (uint64_t i = 0; i < cap; ++i) {
+            auto id = r.get();
+            if (id != empty) {
+                if (id >= nn || indexed[id] || tags[i] != uint8_t(key_hash(tokens.data()+nodes[id].offset) >> 56)) {
+                    throw std::runtime_error("invalid EmeraldMTP index");
+                }
+                indexed[id] = true;
+            } else if (tags[i]) { throw std::runtime_error("invalid EmeraldMTP empty index tag"); }
+            table.push_back(id);
+        }
+        for (uint64_t i = 0; i < nn; ++i) {
+            if (!indexed[i] || find(tokens.data()+nodes[i].offset) != i) { throw std::runtime_error("invalid EmeraldMTP context index"); }
+            auto & m = meta[i]; auto & v = nodes[i]; auto stored_next = v.successor; auto stored_token = v.token;
+            m.best = empty; v.token = -1; std::vector<llama_token> alternatives;
+            for (auto j = m.first; j < m.first+counts[i]; ++j) {
+                auto & e = entries[j];
+                if (!std::equal(tokens.data()+v.offset, tokens.data()+v.offset+n, tokens.data()+e.offset)) {
+                    throw std::runtime_error("EmeraldMTP continuation context mismatch");
+                }
+                e.next = j+1 < m.first+counts[i] ? j+1 : empty;
+                alternatives.push_back(tokens[e.offset+n]); consider(i, j);
+            }
+            std::sort(alternatives.begin(), alternatives.end());
+            if (std::adjacent_find(alternatives.begin(), alternatives.end()) != alternatives.end()) {
+                throw std::runtime_error("duplicate EmeraldMTP continuation");
+            }
+            // consider() invalidates the cached link; validate and restore the serialized link.
+            if (v.token != stored_token || find(tokens.data()+entries[m.best].offset+1) != stored_next) {
+                throw std::runtime_error("invalid EmeraldMTP cached transition");
+            }
+            v.successor = stored_next; m.miss_generation = nn;
+        }
+    }
+};
+}
+
+struct emerald_database::impl {
+    writer_lock lock;
+    std::string path, fingerprint;
+    emerald_graph graph;
+    int32_t vocab_size;
+    uint64_t limit, disk_bytes = 0;
+    bytes pending;
+    bool background, needs_snapshot = false, dirty = false, failed = false, stop = false, learning_paused = false;
+    mutable std::mutex mutex;
+    // Lock order: persistence then mutex. Readers/writers never acquire persistence.
+    std::mutex persistence;
+    std::condition_variable cv;
+    std::thread worker;
+    impl(const std::string & path, const std::string & fp, uint32_t n, uint64_t limit, int32_t vocab, bool background) :
+        lock(path), path(path), fingerprint(fp), graph(n), vocab_size(vocab), limit(limit), background(background) {}
+    void add(const std::vector<llama_token> & seq, bool imported, bool journal) {
+        if (seq.size() <= graph.n) { return; }
+        for (auto t : seq) { if (t < 0 || t >= vocab_size) { throw std::runtime_error("EmeraldMTP token out of vocabulary"); } }
+        graph.add(seq, imported);
+        if (journal) { put(pending, seq.size()); for (auto t : seq) { put(pending, uint32_t(t), 4); } }
+        dirty = true; needs_snapshot = needs_snapshot || imported;
+        bool retained = false;
+        const bool fits = graph.retain(imported, limit, fingerprint.size(), &retained);
+        // A journal records observations, so retention must be committed as a snapshot.
+        needs_snapshot = needs_snapshot || retained;
+        if (!fits || (!imported && limit &&
+                std::none_of(graph.entries.begin(), graph.entries.end(), [](const emerald_graph::entry & e) { return e.learned != 0; }))) {
+            learning_paused = true;
+            std::fprintf(stderr, "EmeraldMTP learning paused: size limit has no room for learned entries\n");
+        }
+    }
+    void compact(emerald_graph & snapshot) {
+        auto b = snapshot.snapshot(fingerprint); const auto temp = path + ".tmp";
+        { std::ofstream out(temp, std::ios::binary | std::ios::trunc); write_frame(out, 1, b); out.flush(); if (!out) { throw std::runtime_error("EmeraldMTP flush failed"); } }
+        sync_file(temp);
+#ifdef _WIN32
+        if (!MoveFileExW(std::filesystem::path(temp).c_str(), std::filesystem::path(path).c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+            throw std::runtime_error("EmeraldMTP replacement failed");
+        }
+#else
+        std::filesystem::rename(temp, path);
+        auto dir = std::filesystem::path(path).parent_path(); if (dir.empty()) { dir = "."; }
+        sync_file(dir.string());
+#endif
+        disk_bytes = frame_header + b.size();
+    }
+    void flush() {
+        std::lock_guard<std::mutex> io(persistence);
+        try {
+            bytes batch; std::unique_ptr<emerald_graph> snapshot;
+            {
+                std::lock_guard<std::mutex> g(mutex);
+                if (failed || !dirty) { return; }
+                // Bound journal growth independently of the configured snapshot limit.
+                const uint64_t target = graph.size(fingerprint.size());
+                if (needs_snapshot || (disk_bytes > target && disk_bytes-target > target) ||
+                        pending.size() > target || (disk_bytes > target && pending.size() > target-(disk_bytes-target))) {
+                    snapshot.reset(new emerald_graph(graph));
+                }
+                batch.swap(pending); dirty = false; needs_snapshot = false;
+            }
+            // The live graph receives observations immediately while this generation is saved.
+            if (snapshot) { compact(*snapshot); }
+            else if (!batch.empty()) {
+                { std::ofstream out(path, std::ios::binary | std::ios::app); write_frame(out, 2, batch); out.flush(); if (!out) { throw std::runtime_error("EmeraldMTP journal flush failed"); } }
+                sync_file(path); disk_bytes += frame_header + batch.size();
+            }
+        } catch (...) {
+            std::lock_guard<std::mutex> g(mutex); failed = true; throw;
+        }
+    }
+    void load(uint32_t requested) {
+        std::ifstream in(path, std::ios::binary); if (!in) { throw std::runtime_error("EmeraldMTP requires an existing database"); }
+        const uint64_t file_size = std::filesystem::file_size(path); uint64_t valid = 0; bool first = true;
+        while (valid < file_size) {
+            bytes h(frame_header); in.read((char *)h.data(), h.size());
+            if (!in) { if (first) { throw std::runtime_error("missing EmeraldMTP snapshot"); } break; }
+            reader hr{h};
+            if (hr.get() != frame_magic) { throw std::runtime_error("invalid EmeraldMTP graph signature"); }
+            auto kind = hr.get(4);
+            if (hr.get(4) || (first ? kind != 1 : kind != 2)) { throw std::runtime_error("invalid EmeraldMTP frame kind"); }
+            auto len = hr.get(), checksum = hr.get();
+            while (hr.pos < h.size()) { if (hr.get()) { throw std::runtime_error("invalid EmeraldMTP frame padding"); } }
+            if (len > file_size-valid-frame_header) { if (first) { throw std::runtime_error("truncated EmeraldMTP snapshot"); } break; }
+            if (len > std::numeric_limits<size_t>::max() || len > uint64_t(std::numeric_limits<std::streamsize>::max())) {
+                throw std::runtime_error("EmeraldMTP transaction exceeds platform address limits");
+            }
+            bytes b(static_cast<size_t>(len)); in.read((char *)b.data(), len);
+            if (!in || hash(b.data(), b.size()) != checksum) { throw std::runtime_error("EmeraldMTP checksum mismatch"); }
+            if (first) { graph.load_snapshot(b, fingerprint, requested, vocab_size); first = false; }
+            else {
+                reader r{b};
+                while (r.pos < b.size()) {
+                    auto count = r.get(); if (count > (b.size()-r.pos)/4) { throw std::runtime_error("invalid EmeraldMTP journal length"); }
+                    std::vector<llama_token> seq; seq.reserve(count);
+                    for (uint64_t i = 0; i < count; ++i) { auto t = r.get(4); if (t >= uint64_t(vocab_size)) { throw std::runtime_error("invalid EmeraldMTP token"); } seq.push_back(t); }
+                    add(seq, false, false);
+                }
+            }
+            valid += frame_header+len;
+        }
+        if (first) { throw std::runtime_error("empty EmeraldMTP database"); }
+        in.close(); if (valid != file_size) { std::filesystem::resize_file(path, valid); }
+        bool retained = false; graph.retain(true, limit, fingerprint.size(), &retained);
+        needs_snapshot = needs_snapshot || retained || (limit && valid > limit);
+        dirty = needs_snapshot; disk_bytes = valid;
+    }
+};
+
+emerald_database::emerald_database(const std::string & path, const std::string & fingerprint, uint32_t n,
+                                 uint64_t max_bytes, bool create, bool background, int32_t vocab_size, bool create_if_missing) :
+        p(new impl(path, fingerprint, n, max_bytes, vocab_size, background)) {
+    const bool missing = create_if_missing && !std::filesystem::exists(path);
+    if (create || missing) {
+        if (std::filesystem::exists(path)) { throw std::runtime_error("output exists; use --append explicitly"); }
+        if (missing && !n) { n = 24; p->graph.n = n; }
+        if (!n || n > 1024) { throw std::runtime_error("n-match must be 1..1024"); }
+        p->graph.retain(true, max_bytes, fingerprint.size()); p->dirty = true; p->needs_snapshot = true;
+        if (missing) { p->flush(); }
+    } else { p->load(n); }
+    if (background) { p->worker = std::thread([this] {
+        std::unique_lock<std::mutex> guard(p->mutex);
+        while (!p->stop) {
+            p->cv.wait_for(guard, std::chrono::seconds(1), [this] { return p->stop; });
+            guard.unlock();
+            try { p->flush(); } catch (const std::exception & e) {
+                std::fprintf(stderr, "EmeraldMTP persistence failed; learning paused: %s\n", e.what());
+            }
+            guard.lock();
+        }
+    }); }
+}
+emerald_database::~emerald_database() {
+    { std::lock_guard<std::mutex> guard(p->mutex); p->stop = true; p->cv.notify_all(); }
+    if (p->worker.joinable()) { p->worker.join(); }
+    try { if (p->background) { flush(); } } catch (const std::exception & e) { std::fprintf(stderr, "EmeraldMTP final flush failed: %s\n", e.what()); }
+}
+uint32_t emerald_database::n_match() const { return p->graph.n; }
+uint64_t emerald_database::size_bytes() const { std::lock_guard<std::mutex> g(p->mutex); return p->graph.size(p->fingerprint.size()); }
+emerald_database_stats emerald_database::statistics(size_t top_k) const {
+    std::lock_guard<std::mutex> g(p->mutex);
+    emerald_database_stats result;
+    result.unique_ngrams = p->graph.entries.size();
+    auto add = [&](uint64_t & total, uint64_t count) {
+        if (count > UINT64_MAX-total) { total = UINT64_MAX; result.counts_saturated = true; }
+        else { total += count; }
+    };
+    // Keep only the requested best entries, without copying the full index.
+    std::vector<size_t> top;
+    auto better = [&](size_t a, size_t b) {
+        const auto & x = p->graph.entries[a]; const auto & y = p->graph.entries[b];
+        const uint64_t xc = x.imported+x.learned, yc = y.imported+y.learned;
+        const bool xo = xc < x.imported, yo = yc < y.imported;
+        if (xo != yo) { return xo; }
+        if (xc != yc) { return xc > yc; }
+        return std::lexicographical_compare(p->graph.tokens.begin()+x.offset, p->graph.tokens.begin()+x.offset+p->graph.n+1,
+                                            p->graph.tokens.begin()+y.offset, p->graph.tokens.begin()+y.offset+p->graph.n+1);
+    };
+    for (size_t i = 0; i < p->graph.entries.size(); ++i) {
+        const auto & e = p->graph.entries[i];
+        if (e.imported) { ++result.imported_ngrams; }
+        add(result.imported, e.imported); add(result.learned, e.learned);
+        if (!top_k) { continue; }
+        auto pos = std::lower_bound(top.begin(), top.end(), i, better);
+        if (top.size() < top_k || pos != top.end()) {
+            top.insert(pos, i);
+            if (top.size() > top_k) { top.pop_back(); }
+        }
+    }
+    for (auto i : top) {
+        const auto & e = p->graph.entries[i];
+        result.top.push_back({std::vector<llama_token>(p->graph.tokens.begin()+e.offset, p->graph.tokens.begin()+e.offset+p->graph.n+1),
+                              e.imported, e.learned});
+    }
+    return result;
+}
+void emerald_database::observe(const std::vector<llama_token> & t, bool imported) {
+    std::lock_guard<std::mutex> g(p->mutex); if (p->failed || (!imported && p->learning_paused)) { return; }
+    p->add(t, imported, !imported);
+}
+void emerald_database::flush() { p->flush(); }
+std::vector<llama_token> emerald_database::draft(const std::vector<llama_token> & context, uint32_t n_min, uint32_t n_max) {
+    std::lock_guard<std::mutex> lock(p->mutex); std::vector<llama_token> out;
+    auto & g = p->graph;
+    if (context.size() < g.n || g.nodes.empty() || !n_max) { return out; }
+    auto id = g.find(context.data()+context.size()-g.n);
+    if (id == empty) { return out; }
+    out.reserve(n_max);
+    while (id != empty && out.size() < n_max) {
+        out.push_back(g.nodes[id].token);
+        if (out.size() < n_max) { id = g.successor(id); }
+    }
+    if (out.size() < n_min) { out.clear(); }
+    return out;
+}
