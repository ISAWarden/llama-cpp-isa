+#include "common.h"
+#include "emerald-mtp.h"
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <map>
+#include <iomanip>
+#include <sstream>
+#include <thread>
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <regex>
+#include <set>
+#include <stdexcept>
+#ifdef _WIN32
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+namespace fs = std::filesystem;
+using clock_type = std::chrono::steady_clock;
+
+// Globs match relative generic paths: * excludes '/', ** includes it, ? matches one character.
+static std::regex glob(const std::string & s) {
+    std::string r = "^";
+    for (size_t i = 0; i < s.size(); ++i) {
+        char c = s[i];
+        if (c == '*') {
+            if (i+1 < s.size() && s[i+1] == '*') {
+                ++i;
+                if (i+1 < s.size() && s[i+1] == '/') { ++i; r += "(?:.*/)?"; }
+                else { r += ".*"; }
+            } else { r += "[^/]*"; }
+        } else if (c == '?') { r += "[^/]"; }
+        else { if (std::string(".\\+()[]{}^$|").find(c) != std::string::npos) { r += '\\'; } r += c; }
+    }
+    return std::regex(r + "$", std::regex::ECMAScript);
+}
+static bool matches(const std::string & s, const std::vector<std::regex> & patterns) {
+    for (auto & p : patterns) { if (std::regex_match(s, p)) { return true; } } return false;
+}
+static bool text_utf8(const std::string & s) {
+    for (size_t i = 0; i < s.size();) {
+        uint32_t c = uint8_t(s[i++]);
+        if (c < 128) { if (c == 0 || (c < 32 && c != 9 && c != 10 && c != 13 && c != 12)) { return false; } continue; }
+        unsigned n; uint32_t min;
+        if (c >= 0xc2 && c <= 0xdf) { n = 1; c &= 31; min = 128; }
+        else if (c >= 0xe0 && c <= 0xef) { n = 2; c &= 15; min = 2048; }
+        else if (c >= 0xf0 && c <= 0xf4) { n = 3; c &= 7; min = 65536; }
+        else { return false; }
+        if (n > s.size()-i) { return false; }
+        while (n--) { uint8_t d = s[i++]; if ((d & 0xc0) != 0x80) { return false; } c = (c << 6) | (d & 63); }
+        if (c < min || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff)) { return false; }
+    }
+    return true;
+}
+struct progress {
+    clock_type::time_point start = clock_type::now(), last = start;
+#ifdef _WIN32
+    bool terminal = _isatty(_fileno(stderr));
+#else
+    bool terminal = isatty(fileno(stderr));
+#endif
+    void show(const char * stage, uint64_t done, uint64_t total, uint64_t bytes, uint64_t all_bytes, bool force = false) {
+        auto now = clock_type::now();
+        if (!force && now-last < std::chrono::seconds(1)) { return; } last = now;
+        double elapsed = std::chrono::duration<double>(now-start).count();
+        double fraction = total ? double(done)/total : 0;
+        int bars = int(fraction*24);
+        double rate = elapsed > 0 ? bytes/elapsed : 0;
+        std::fprintf(stderr, "%s%s [%s%s] %llu/%s files, %llu/%s bytes, %.2f MB/s, %.1fs elapsed",
+                     terminal ? "\r" : "", stage, std::string(bars, '#').c_str(), std::string(24-bars, '-').c_str(),
+                     (unsigned long long)done, (total ? std::to_string(total) : "?").c_str(), (unsigned long long)bytes,
+                     (all_bytes ? std::to_string(all_bytes) : "?").c_str(), rate/1e6, elapsed);
+        if (rate > 0 && all_bytes >= bytes) { std::fprintf(stderr, ", ETA %.1fs", (all_bytes-bytes)/rate); }
+        std::fprintf(stderr, "%s", terminal && !force ? "    " : "\n");
+    }
+};
+// Keep progress alive during a large file's tokenization and during atomic saving.
+struct reporter {
+    progress bar;
+    const char * stage;
+    uint64_t total, all_bytes;
+    std::atomic<uint64_t> done{0}, bytes{0};
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool stop = false;
+    std::thread worker;
+    reporter(const char * stage, uint64_t total, uint64_t all_bytes) : stage(stage), total(total), all_bytes(all_bytes) {
+        worker = std::thread([this] {
+            std::unique_lock<std::mutex> guard(mutex);
+            while (!cv.wait_for(guard, std::chrono::seconds(1), [this] { return stop; })) {
+                bar.show(this->stage, done, this->total, bytes, this->all_bytes, true);
+            }
+        });
+    }
+    ~reporter() {
+        { std::lock_guard<std::mutex> guard(mutex); stop = true; cv.notify_all(); }
+        worker.join(); bar.show(stage, done, total, bytes, all_bytes, true);
+    }
+};
+struct input_file { fs::path path; uint64_t size; };
+struct tokenized_file {
+    std::vector<llama_token> tokens;
+    uint64_t bytes = 0;
+    bool text = false;
+    std::exception_ptr error;
+};
+static tokenized_file tokenize_file(const input_file & f, const llama_vocab * vocab) {
+    tokenized_file result;
+    try {
+        std::ifstream in(f.path, std::ios::binary);
+        if (!in) { throw std::runtime_error("unreadable selected file: " + f.path.string()); }
+        std::string text((std::istreambuf_iterator<char>(in)), {});
+        if (in.bad()) { throw std::runtime_error("read failed: " + f.path.string()); }
+        result.bytes = text.size();
+        result.text = text_utf8(text);
+        if (result.text) {
+            if (text.size() > INT32_MAX) { throw std::runtime_error("individual file exceeds tokenizer's INT32_MAX byte limit"); }
+            result.tokens = common_tokenize(vocab, text, false, false);
+        }
+    } catch (...) { result.error = std::current_exception(); }
+    return result;
+}
+// Bounded lookahead; workers share the immutable vocabulary, never the database.
+// The source-byte budget is not a RAM limit; one oversized file may run alone.
+class tokenizer_queue {
+    const std::vector<input_file> & files;
+    const llama_vocab * vocab;
+    std::vector<tokenized_file> results;
+    std::vector<bool> ready;
+    std::vector<std::thread> workers;
+    std::mutex mutex;
+    std::condition_variable cv;
+    size_t next = 0, consumed = 0;
+    uint64_t pending_bytes = 0;
+    bool stop = false;
+    void finish() {
+        { std::lock_guard<std::mutex> lock(mutex); stop = true; }
+        cv.notify_all();
+        for (auto & worker : workers) { worker.join(); }
+    }
+public:
+    tokenizer_queue(const std::vector<input_file> & files, const llama_vocab * vocab, size_t threads)
+        : files(files), vocab(vocab), results(2*threads), ready(2*threads, false) {
+        try {
+            for (size_t i = 0; i < threads; ++i) {
+                workers.emplace_back([this] {
+                    for (;;) {
+                        size_t index;
+                        {
+                            std::unique_lock<std::mutex> lock(mutex);
+                            cv.wait(lock, [this] {
+                                return stop || next == this->files.size() ||
+                                    (next-consumed < results.size() &&
+                                     (next == consumed || (pending_bytes <= 32*1024*1024 &&
+                                      this->files[next].size <= 32*1024*1024-pending_bytes)));
+                            });
+                            if (stop || next == this->files.size()) { return; }
+                            index = next++;
+                            pending_bytes += this->files[index].size;
+                        }
+                        auto result = tokenize_file(this->files[index], this->vocab);
+                        {
+                            std::lock_guard<std::mutex> lock(mutex);
+                            results[index % results.size()] = std::move(result);
+                            ready[index % results.size()] = true;
+                        }
+                        cv.notify_all();
+                    }
+                });
+            }
+        } catch (...) { finish(); throw; }
+    }
+    ~tokenizer_queue() { finish(); }
+    tokenized_file take() {
+        std::unique_lock<std::mutex> lock(mutex);
+        const size_t slot = consumed % results.size();
+        cv.wait(lock, [&] { return ready[slot]; });
+        auto result = std::move(results[slot]);
+        ready[slot] = false;
+        pending_bytes -= files[consumed++].size;
+        lock.unlock(); cv.notify_all();
+        return result;
+    }
+};
+
+// Escape controls and cap previews so corpus text cannot disrupt terminal output.
+static std::string preview(const std::string & text) {
+    std::ostringstream out;
+    out << '"';
+    const size_t limit = std::min(text.size(), size_t(160));
+    for (size_t i = 0; i < limit; ++i) {
+        const unsigned char c = text[i];
+        if (c == '\n') { out << "\\n"; }
+        else if (c == '\r') { out << "\\r"; }
+        else if (c == '\t') { out << "\\t"; }
+        else if (c == '"' || c == '\\') { out << '\\' << char(c); }
+        else if (c < 32 || c >= 127) { out << "\\x" << std::hex << std::setw(2) << std::setfill('0') << unsigned(c); }
+        else { out << char(c); }
+    }
+    if (limit < text.size()) { out << "..."; }
+    out << '"';
+    return out.str();
+}
+int main(int argc, char ** argv) {
+    try {
+        const auto started = clock_type::now();
+        size_t threads = std::min(8u, std::max(1u, std::thread::hardware_concurrency()));
+        std::string model, output; std::vector<std::string> inputs;
+        std::vector<std::regex> includes, excludes; uint32_t n = 0; uint64_t limit = 0; bool append = false, verbose = false;
+        for (int i = 1; i < argc; ++i) {
+            std::string arg = argv[i];
+            if (arg == "--help" || arg == "-h") {
+                std::cout << "pretrain-emerald-mtp -m MODEL --input PATH [--input PATH ...] --output DB\n"
+                             "  --n-match N        Lookup length (default: 24, inferred on append)\n"
+                             "  --max-size-gb GB   Decimal GB; 0 means unlimited\n"
+                             "  --append           Explicitly extend an existing compatible database\n"
+                             "  --include GLOB     Repeatable relative path glob (*, **, ?)\n"
+                             "  --exclude GLOB     Repeatable exclusion glob; exclusions win\n"
+                             "  --threads N        CPU tokenization workers (default: up to 8; 1 = serial)\n"
+                             "  --verbose          Report files skipped by glob filters\n"; return 0;
+            }
+            if (arg == "--verbose") { verbose = true; continue; }
+            if (arg == "--append") { append = true; continue; }
+            if (++i == argc) { throw std::runtime_error("missing value for " + arg); }
+            std::string v = argv[i];
+            if (arg == "-m" || arg == "--model") { model = v; }
+            else if (arg == "--input") { inputs.push_back(v); }
+            else if (arg == "--output") { output = v; }
+            else if (arg == "--include") { includes.push_back(glob(v)); }
+            else if (arg == "--exclude") { excludes.push_back(glob(v)); }
+            else if (arg == "--max-size-gb") { limit = emerald_size_limit(v); }
+            else if (arg == "--threads" || arg == "-t") {
+                size_t end; auto value = std::stol(v, &end);
+                if (end != v.size() || value < 1 || value > 256) { throw std::runtime_error("threads must be 1..256"); }
+                threads = value;
+            }
+            else if (arg == "--n-match") {
+                size_t end; auto value = std::stol(v, &end);
+                if (end != v.size() || value < 1 || value > 1024) { throw std::runtime_error("n-match must be 1..1024"); } n = value;
+            } else { throw std::runtime_error("unknown argument: " + arg); }
+        }
+        if (model.empty() || output.empty() || inputs.empty()) { throw std::runtime_error("model, input and output are required; see --help"); }
+        std::fprintf(stderr, "Discovery: scanning inputs\n"); progress bar;
+        std::vector<input_file> files; std::set<std::string> seen;
+        uint64_t total_bytes = 0, skipped = 0;
+        std::map<std::string, uint64_t> skip_reasons;
+        auto skip = [&](const fs::path & p, const char * why, bool report = true) {
+            ++skipped; ++skip_reasons[why];
+            if (report) { std::fprintf(stderr, "skip %s: %s\n", p.string().c_str(), why); }
+        };
+        auto select = [&](const fs::path & p, const std::string & relative) {
+            if ((!includes.empty() && !matches(relative, includes)) || matches(relative, excludes)) { skip(p, "glob filter", verbose); return; }
+            auto key = fs::canonical(p).string();
+            if (!seen.insert(key).second) { skip(p, "duplicate input"); return; }
+            auto size = fs::file_size(p); files.push_back({p, size}); total_bytes += size;
+            bar.show("Discovery", files.size(), 0, total_bytes, 0);
+        };
+        for (auto & input : inputs) {
+            fs::path root(input); auto status = fs::symlink_status(root);
+            if (fs::is_symlink(status) || root.filename() == ".git") { skip(root, "symlink or .git"); continue; }
+            if (fs::is_regular_file(status)) { select(root, root.filename().generic_string()); }
+            else if (fs::is_directory(status)) {
+                if (root.filename() == ".git") { skip(root, ".git"); continue; }
+                std::function<void(const fs::path &)> visit = [&](const fs::path & directory) {
+                    std::vector<fs::path> children;
+                    for (const auto & item : fs::directory_iterator(directory)) { children.push_back(item.path()); }
+                    std::sort(children.begin(), children.end());
+                    for (const auto & p : children) {
+                        auto st = fs::symlink_status(p);
+                        if (fs::is_symlink(st) || p.filename() == ".git") { skip(p, "symlink or .git"); }
+                        else if (fs::is_directory(st)) { visit(p); }
+                        else if (fs::is_regular_file(st)) { select(p, p.lexically_relative(root).generic_string()); }
+                        else { skip(p, "not a regular file"); }
+                    }
+                };
+                visit(root);
+            } else { throw std::runtime_error("unreadable input: " + input); }
+        }
+        std::sort(files.begin(), files.end(), [](const input_file & a, const input_file & b) { return a.path.generic_string() < b.path.generic_string(); });
+        bar.show("Discovery", files.size(), files.size(), total_bytes, total_bytes, true);
+        auto fp = emerald_tokenizer_fingerprint(model);
+        llama_model_params params = llama_model_default_params(); params.vocab_only = true;
+        llama_model_ptr vocab_model(llama_model_load_from_file(model.c_str(), params));
+        if (!vocab_model) { throw std::runtime_error("cannot load vocabulary"); }
+        emerald_database db(output, fp, n ? n : (append ? 0 : 24), limit, !append, false, llama_vocab_n_tokens(llama_model_get_vocab(vocab_model.get())));
+        const auto before = db.statistics(0);
+        uint64_t imported_files = 0, imported_bytes = 0, imported_tokens = 0, added = 0, short_files = 0;
+        {
+        const auto * vocab = llama_model_get_vocab(vocab_model.get());
+        threads = std::min(threads, std::max(size_t(1), files.size()));
+        std::fprintf(stderr, "Tokenization: %zu CPU worker(s); ordered database indexing\n", threads);
+        std::unique_ptr<tokenizer_queue> queue;
+        if (threads > 1) { queue.reset(new tokenizer_queue(files, vocab, threads)); }
+        reporter indexing("Tokenization/indexing", files.size(), total_bytes);
+        for (auto & f : files) {
+            auto result = queue ? queue->take() : tokenize_file(f, vocab);
+            if (result.error) { std::rethrow_exception(result.error); }
+            if (!result.text) { skip(f.path, "binary or invalid UTF-8"); }
+            else {
+                db.observe(result.tokens, true);
+                ++imported_files; imported_bytes += result.bytes; imported_tokens += result.tokens.size();
+                if (result.tokens.size() > db.n_match()) { added += result.tokens.size()-db.n_match(); }
+                else { ++short_files; }
+            }
+            indexing.bytes += f.size; ++indexing.done;
+        }
+        }
+        std::fprintf(stderr, "Saving: compacting database (atomic replacement needs a second copy)\n");
+        { reporter saving("Saving", 1, 0); db.flush(); saving.bytes = db.size_bytes(); saving.done = 1; }
+        std::fprintf(stderr, "Saved %s: %llu compacted bytes; %llu skipped files\n", output.c_str(),
+                     (unsigned long long)db.size_bytes(), (unsigned long long)skipped);
+        const auto stats = db.statistics();
+        const double elapsed = std::chrono::duration<double>(clock_type::now()-started).count();
+        std::fprintf(stderr, "Import summary (this run):\n"
+                             "  Files: %llu selected, %llu imported, %llu too short for an n-gram\n"
+                             "  Imported: %llu bytes, %llu tokens; %.2fs elapsed\n"
+                             "  N-grams added: %llu occurrences, %llu new unique imported n-grams\n",
+                     (unsigned long long)files.size(), (unsigned long long)imported_files, (unsigned long long)short_files,
+                     (unsigned long long)imported_bytes, (unsigned long long)imported_tokens, elapsed,
+                     (unsigned long long)added,
+                     (unsigned long long)(stats.imported_ngrams-before.imported_ngrams));
+        for (const auto & reason : skip_reasons) {
+            std::fprintf(stderr, "  Skipped (%s): %llu\n", reason.first.c_str(), (unsigned long long)reason.second);
+        }
+        if (files.empty()) { std::fprintf(stderr, "  No files selected: check --input and relative-path --include/--exclude globs.\n"); }
+        std::fprintf(stderr, "Database totals (including previous imports/learning):\n"
+                             "  %llu unique %u-token n-grams (n-match %u + next token)\n"
+                             "  Occurrences: %llu imported, %llu learned%s\n"
+                             "Top %zu n-grams by imported + learned occurrences:\n",
+                     (unsigned long long)stats.unique_ngrams, db.n_match()+1, db.n_match(),
+                     (unsigned long long)stats.imported, (unsigned long long)stats.learned,
+                     stats.counts_saturated ? " (totals saturated at UINT64_MAX)" : "", stats.top.size());
+        for (size_t i = 0; i < stats.top.size(); ++i) {
+            const auto & entry = stats.top[i];
+            std::fprintf(stderr, "  %zu. imported=%llu learned=%llu %s\n", i+1,
+                         (unsigned long long)entry.imported, (unsigned long long)entry.learned,
+                         preview(common_detokenize(llama_model_get_vocab(vocab_model.get()), entry.tokens, true)).c_str());
+        }
+        if (stats.top.empty()) { std::fprintf(stderr, "  (none)\n"); }
+        return 0;
+    } catch (const std::exception & e) { std::fprintf(stderr, "pretrain-emerald-mtp: %s\n", e.what()); return 1; }
+}
