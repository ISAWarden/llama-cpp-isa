@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Importer filesystem and atomic append checks; requires a local GGUF vocabulary/model."""
+import argparse
+import hashlib
+import pathlib
+import subprocess
+import tempfile
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--importer", required=True)
+    p.add_argument("--model", required=True)
+    args = p.parse_args()
+    with tempfile.TemporaryDirectory(prefix="emerald-import-test-") as temp:
+        root = pathlib.Path(temp)
+        source = root / "source"
+        source.mkdir()
+        (source / "a.txt").write_bytes(b"one two three four five six seven eight nine ten\n\n  spaces\tand tabs\n")
+        (source / "binary.txt").write_bytes(b"hello\x00world")
+        (source / "invalid.txt").write_bytes(b"\xed\xa0\x80")
+        (source / "ignored.md").write_text("not selected")
+        (source / ".git").mkdir()
+        (source / ".git" / "secret.txt").write_text("not imported")
+        (source / "link.txt").symlink_to(source / "a.txt")
+        db = root / "db.bin"
+        def run(*extra, ok=True):
+            r = subprocess.run([args.importer, "-m", args.model, "--input", str(source),
+                                "--output", str(db), "--include", "**/*.txt", *extra], capture_output=True, text=True, errors="replace", timeout=120)
+            assert (r.returncode == 0) == ok, r.stderr
+            return r.stderr
+        # Parallel tokenization must preserve byte-identical snapshots and append order.
+        parallel_source = root / "parallel"
+        parallel_source.mkdir()
+        for i in range(24):
+            (parallel_source / f"{i:03}.txt").write_text(("one two three four five " + str(i) + "\n") * (i+1))
+        # A file larger than the lookahead budget must run alone without blocking later files.
+        with (parallel_source / "000-large.txt").open("wb") as large:
+            large.truncate(33*1024*1024)
+        outputs = []
+        for workers in (1, 2, 8):
+            output = root / f"parallel-{workers}.bin"
+            command = [args.importer, "-m", args.model, "--input", str(parallel_source),
+                       "--output", str(output), "--n-match", "4", "--threads", str(workers)]
+            subprocess.run(command, capture_output=True, text=True, errors="replace", check=True, timeout=120)
+            initial = output.read_bytes()
+            subprocess.run([*command, "--append"], capture_output=True, text=True, errors="replace", check=True, timeout=120)
+            outputs.append((initial, output.read_bytes()))
+        assert outputs[0] == outputs[1] == outputs[2]
+        run("--threads", "0", ok=False)
+        run("--threads", "257", ok=False)
+        log = run("--n-match", "4")
+        assert "symlink or .git" in log and "binary or invalid UTF-8" in log and ": glob filter" not in log
+        assert "Tokenization/indexing" in log and "Saving" in log
+        assert "Import summary (this run):" in log and "N-grams added:" in log
+        assert "3 selected, 1 imported" in log and "learned=0" in log
+        old = hashlib.sha256(db.read_bytes()).digest()
+        run(ok=False)
+        assert hashlib.sha256(db.read_bytes()).digest() == old
+        run("--append", "--n-match", "5", ok=False)
+        assert hashlib.sha256(db.read_bytes()).digest() == old
+        run("--append", "--max-size-gb", "0.000000001", ok=False)
+        assert hashlib.sha256(db.read_bytes()).digest() == old
+        log = run("--append", "--verbose")
+        assert "skip " + str(source / "ignored.md") + ": glob filter" in log
+        assert "0 new unique imported n-grams" in log
+        assert hashlib.sha256(db.read_bytes()).digest() != old
+        log = run("--append", "--exclude", "**")
+        assert "0 selected, 0 imported" in log and "No files selected" in log
+        assert "N-grams added: 0 occurrences, 0 new unique imported n-grams" in log
+        # A selected file that cannot be opened must fail the entire import, without saving partial counts.
+        old = hashlib.sha256(db.read_bytes()).digest()
+        locked = source / "unreadable.txt"
+        locked.write_text("unreadable")
+        locked.chmod(0)
+        try:
+            run("--append", ok=False)
+            assert hashlib.sha256(db.read_bytes()).digest() == old
+        finally:
+            locked.chmod(0o600)
+    print("Importer traversal, UTF-8, globs, replacement, append, mismatch, size limit and unreadable-file checks passed")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test-emerald-mtp-server.py b/tests/test-emerald-mtp-server.py
new file mode 100644
index 0000000000000000000000000000000000000000..8cc0134033143fcb41889d54ce3aba073eb4f603
--- /dev/null
+++ b/tests/test-emerald-mtp-server.py
@@ -0,0 +1,267 @@
+#!/usr/bin/env python3
+"""Opt-in real-model regression and benchmark. Uses only Python's standard library.
+
+python3 tests/test-emerald-mtp-server.py --server build/bin/llama-server \
+  --upstream /path/to/pristine/llama-server --importer build/bin/pretrain-emerald-mtp \
+  --model model.gguf --output-dir /tmp/emerald-validation
+"""
+import argparse
+import collections
+import concurrent.futures
+import contextlib
+import json
+import pathlib
+import signal
+import shutil
+import socket
+import struct
+import subprocess
+import time
+import urllib.request
+
+
+def post(port, route, payload):
+    req = urllib.request.Request(f"http://127.0.0.1:{port}/{route}",
+                                 json.dumps(payload).encode(), {"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=120) as response:
+        return json.load(response)
+
+
+@contextlib.contextmanager
+def server(binary, model, directory, name, extra=(), crash=False):
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        port = s.getsockname()[1]
+    log = open(directory / (name + ".log"), "w")
+    command = [binary, "-m", model, "-t", "4", "-c", "2048", "-np", "2", "-fa", "on",
+               "--host", "127.0.0.1", "--port", str(port), *extra]
+    process = subprocess.Popen(command, stdout=log, stderr=log)
+    try:
+        for _ in range(240):
+            if process.poll() is not None:
+                raise RuntimeError(f"server exited: {directory / (name + '.log')}")
+            try:
+                urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=1).close()
+                break
+            except Exception:
+                time.sleep(0.25)
+        else:
+            raise RuntimeError("server readiness timed out")
+        yield port
+    finally:
+        if crash:
+            process.kill()
+        else:
+            process.send_signal(signal.SIGTERM)
+        try:
+            process.wait(timeout=30)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+        log.close()
+
+
+def completion(port, prompt, **kwargs):
+    body = dict(prompt=prompt, n_predict=96, temperature=0, seed=123, cache_prompt=False,
+                return_tokens=True, ignore_eos=True)
+    body.update(kwargs)
+    start = time.perf_counter()
+    result = post(port, "completion", body)
+    result["wall_seconds"] = time.perf_counter() - start
+    return result
+
+
+def learned_counts(path):
+    """Independent decoder checks persisted counts, including un-compacted journal frames."""
+    data = path.read_bytes()
+    pos = 0
+    learned = collections.Counter()
+    n = None
+    while pos < len(data):
+        magic, kind, flags, length, checksum = struct.unpack_from("<QIIQQ", data, pos)
+        assert magic == 0x3130485041524745 and flags == 0
+        assert data[pos+32:pos+64] == bytes(32)
+        b = data[pos+64:pos+64+length]
+        assert len(b) == length
+        h = 14695981039346656037
+        for byte in b:
+            h = ((h ^ byte) * 1099511628211) & ((1 << 64)-1)
+        assert h == checksum
+        if kind == 1:
+            assert n is None
+            n, = struct.unpack_from("<I", b)
+            nt, nn, ne, cap = struct.unpack_from("<QQQQ", b, 24)
+            fp_at, tok_at, node_at, edge_at, index_at, tag_at, end = struct.unpack_from("<7Q", b, 56)
+            assert end == len(b)
+            tokens = struct.unpack_from(f"<{nt}i", b, tok_at)
+            for i in range(ne):
+                at, imported, count, seen = struct.unpack_from("<QQQQ", b, edge_at+i*32)
+                if count:
+                    learned[tuple(tokens[at:at+n+1])] += count
+        else:
+            assert kind == 2 and n
+            offset = 0
+            while offset < len(b):
+                count, = struct.unpack_from("<Q", b, offset)
+                offset += 8
+                seq = struct.unpack_from(f"<{count}i", b, offset)
+                offset += count*4
+                learned.update(tuple(seq[i:i+n+1]) for i in range(len(seq)-n))
+        pos += 64+length
+    return n, learned
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    for name in ("server", "upstream", "importer", "model", "output-dir"):
+        parser.add_argument("--" + name, required=True)
+    args = parser.parse_args()
+    out = pathlib.Path(args.output_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    prompt = "// Implement a C++ function for binary search in a sorted vector of integers.\n// Return the index of the target, or -1 when it is absent.\n"
+    unrelated = "The planet Saturn has a system of rings. Explain their composition and how astronomers study them.\n"
+    with server(args.upstream, args.model, out, "bootstrap") as port:
+        seed = completion(port, prompt, n_predict=192)
+    corpus = out / "source.txt"
+    corpus.write_text(prompt + seed["content"])
+    database = out / "source.bin"
+    with open(out / "import.log", "w") as log:
+        subprocess.run([args.importer, "-m", args.model, "--input", str(corpus), "--output", str(database)],
+                       check=True, stdout=log, stderr=log)
+    for index, (extra, message) in enumerate([
+        ([], "--spec-type emerald-mtp requires --spec-emerald-mtp-file PATH"),
+        (["--spec-emerald-mtp-file", str(database), "--spec-emerald-mtp-n-match", "5"], "lookup length mismatch"),
+        (["--spec-emerald-mtp-file", str(database), "--spec-emerald-mtp-n-min", "17"], "n-min <= n-max"),
+        (["--spec-emerald-mtp-file", str(database), "--spec-synth-len", "2"], "rejects synthetic"),
+        (["--spec-emerald-mtp-file", str(database), "--override-kv", "tokenizer.ggml.add_bos_token=bool:true"], "metadata overrides"),
+    ]):
+        rejected = subprocess.run([args.server, "-m", args.model, "-t", "4", "-c", "2048", "--port", "0",
+                                   "--spec-type", "emerald-mtp", *extra], capture_output=True, text=True, timeout=30)
+        (out / f"startup-rejection-{index}.log").write_text(rejected.stdout + rejected.stderr)
+        assert rejected.returncode != 0 and message in rejected.stderr, (message, rejected.stderr)
+        if index == 0:
+            assert "loading model" not in rejected.stderr, "required argument was checked after model loading"
+    results = {}
+    for name, binary, extra in [
+        ("upstream", args.upstream, []),
