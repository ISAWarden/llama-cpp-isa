+        } else {
+            const int64_t duty = (ytiles + nth - 1) / nth;
+            start = duty * ith; end = start + duty; if (end > ytiles) end = ytiles;
+        }
+        const __m256i shifts  = _mm256_setr_epi64x(0, 2, 4, 6);
+        const __m256i mask3   = _mm256_set1_epi8(3);
