+    const __m256 h1 = _mm256_hadd_ps(lo23, hi23);
+    const __m256 hh = _mm256_hadd_ps(h0, h1);
+    return _mm_add_ps(_mm256_castps256_ps128(hh), _mm256_extractf128_ps(hh, 1));
