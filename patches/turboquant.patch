+static bool llama_ggml_type_is_turbo(ggml_type type) {
+    return type == GGML_TYPE_TURBO2_0 || type == GGML_TYPE_TURBO3_0 || type == GGML_TYPE_TURBO4_0;
+}
+
+// Cache writes are in-place: the scheduler cannot move an unsupported SET_ROWS
+// operation away from an already allocated device buffer. Probe before allocation.
+static bool llama_kv_cache_supports_set_rows(ggml_backend_dev_t dev, ggml_type type, int64_t width) {
+    ggml_init_params params = { 4 * ggml_tensor_overhead(), nullptr, true };
+    ggml_context_ptr ctx(ggml_init(params));
+    if (!ctx) {
+        throw std::runtime_error("failed to create KV cache capability probe");
+    }
+
+    auto * cache = ggml_new_tensor_2d(ctx.get(), type, width, 1);
+    auto * values = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, width, 1);
+    auto * indices = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I64, 1);
+    auto * write = ggml_set_rows(ctx.get(), cache, values, indices);
+    if (llama_ggml_type_is_turbo(type)) {
+        const int32_t wht_group = 128;
+        memcpy(write->op_params, &wht_group, sizeof(wht_group));
+    }
+    return ggml_backend_dev_supports_op(dev, write);
+}
