diff --git a/ggml/src/ggml-metal/kernels/dequantize.h b/ggml/src/ggml-metal/kernels/dequantize.h
index 0d1429d9d368255f15bd77cecc962fb90d819556..b5af4cc80da32e765cd80fdee75c614adaf38571 100644
--- a/ggml/src/ggml-metal/kernels/dequantize.h
+++ b/ggml/src/ggml-metal/kernels/dequantize.h
@@ -733,3 +733,40 @@ void dequantize_tq2_0(device const block_tq2_0 * xb, short il, thread type4x4 &

     reg = (type4x4) reg_f;
 }
+
+// TurboQuant dequantization stays in the rotated domain.
+constant float turbo_centroids_4bit[16] = {
+    -0.173926f, -0.117195f, -0.089527f, -0.068756f,
+    -0.051262f, -0.035597f, -0.020989f, -0.006938f,
+     0.006938f,  0.020989f,  0.035597f,  0.051262f,
+     0.068756f,  0.089527f,  0.117195f,  0.173926f
+};
+
+template <typename type4x4>
+void dequantize_turbo4_0(device const block_turbo4_0 * xb, short il, thread type4x4 & reg) {
+    const float norm = float(xb->norm);
+    const int base = il * 16;
+    float4x4 reg_f;
+
+    for (int g = 0; g < 4; g++) {
+        for (int k = 0; k < 4; k++) {
+            const int j = base + g * 4 + k;
+            const uint8_t idx = (xb->qs[j / 2] >> ((j & 1) * 4)) & 0x0F;
+            reg_f[g][k] = turbo_centroids_4bit[idx] * norm;
+        }
+    }
+
+    reg = (type4x4) reg_f;
+}
+
+template <typename type4>
+void dequantize_turbo4_0_t4(device const block_turbo4_0 * xb, short il, thread type4 & reg) {
+    const float norm = float(xb->norm);
+    const int base = il * 4;
+
+    for (int i = 0; i < 4; i++) {
+        const int j = base + i;
+        const uint8_t idx = (xb->qs[j / 2] >> ((j & 1) * 4)) & 0x0F;
+        reg[i] = turbo_centroids_4bit[idx] * norm;
+    }
+}
