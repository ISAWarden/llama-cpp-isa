+// Standalone signed/normalized WHT, including the optional per-element scale.
+// A workgroup owns one rotation group; no CPU synchronization is required.
+kernel void kernel_turbo_wht_f32(
+        constant ggml_metal_kargs_turbo_wht & args,
+        device const float * src,
+        device float * dst,
+        device const float * scale,
+        threadgroup float * x [[threadgroup(0)]],
+        uint group [[threadgroup_position_in_grid]],
+        uint lane [[thread_position_in_threadgroup]]) {
+    const uint64_t base = uint64_t(group) * uint64_t(args.group_size);
+    const float first = args.direction == 0 ? turbo_wht_signs1[lane] : turbo_wht_signs2[lane];
+    const float last = args.direction == 0 ? turbo_wht_signs2[lane] : turbo_wht_signs1[lane];
+    float value = src[base + lane] * first;
+    if (args.has_scale) value *= scale[lane];
+    x[lane] = value;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint h = 1; h < uint(args.group_size); h *= 2) {
+        if ((lane & h) == 0) {
+            const float a = x[lane];
+            const float b = x[lane + h];
+            x[lane] = a + b;
+            x[lane + h] = a - b;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    dst[base + lane] = x[lane] * (1.0f/sqrt(float(args.group_size))) * last;
+}
+
+static void turbo_fwht_128(thread float * x) {
+    for (int h = 1; h < 128; h *= 2) {
+        for (int i = 0; i < 128; i += h * 2) {
+            for (int j = i; j < i + h; j++) {
+                float a = x[j];
+                float b = x[j + h];
+                x[j]     = a + b;
+                x[j + h] = a - b;
+            }
+        }
+    }
+
+    const float inv_sqrt_128 = 0.08838834764831845f;
+    for (int i = 0; i < 128; i++) {
+        x[i] *= inv_sqrt_128;
+    }
+}
+
+static void turbo_rotate_forward(thread float * x, constant float * s1, constant float * s2) {
+    for (int i = 0; i < 128; i++) {
+        x[i] *= s1[i];
+    }
+    turbo_fwht_128(x);
+    for (int i = 0; i < 128; i++) {
+        x[i] *= s2[i];
+    }
+}
