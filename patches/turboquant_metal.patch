+            else if (rv < turbo_mid_3bit[2]) idx = 2;
+            else if (rv < turbo_mid_3bit[3]) idx = 3;
+            else if (rv < turbo_mid_3bit[4]) idx = 4;
+            else if (rv < turbo_mid_3bit[5]) idx = 5;
+            else if (rv < turbo_mid_3bit[6]) idx = 6;
+            else                             idx = 7;
+
+            blk.qs[j / 4] |= (idx & 0x3) << ((j % 4) * 2);
+            if (idx & 0x4) {
