--- a/ggml/src/ggml-metal/kernels/dequantize.h
+++ b/ggml/src/ggml-metal/kernels/dequantize.h
@@ -733,3 +733,40 @@ void dequantize_tq2_0(device const block_tq2_0 * xb, short il, thread type4x4 &

